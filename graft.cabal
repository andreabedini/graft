cabal-version:   3.0
name:            graft
version:         0.1.0.0
synopsis:        Immutable, lossless concrete syntax trees
description:
    A small, idiomatic Haskell port of Rowan's concrete syntax infrastructure.
    Green trees preserve token text, cache UTF-8 byte lengths, and support
    structural sharing. Immutable red cursors provide navigation, source ranges,
    and persistent subtree and child editing. Pure builders support positional
    checkpoints and reuse of existing subtrees. Typed AST views retain concrete
    syntax through cursors. Lexing and parsing are left to callers.
category:        Language
license:         MIT
license-files:   LICENSE licenses/ROWAN-MIT
copyright:       2026 Andrea Bedini
author:          Andrea Bedini
maintainer:      andrea@bedini.au
build-type:      Simple
tested-with:     GHC ==9.8.4 || ==9.10.3 || ==9.12.2 || ==9.14.1
extra-source-files:
    bench/run.py
    bench/results/**/*.csv
    bench/results/**/*.json
extra-doc-files:
    README.md
    CHANGELOG.md
    CONTRIBUTING.md
    NOTICE
    docs/architecture.md
    docs/performance.md
    bench/README.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Graft Graft.Green Graft.Edit Graft.Range Graft.Cursor Graft.Builder Graft.Ast Graft.LineIndex
    other-modules:    Graft.Green.Internal
    build-depends:
        base >=4.19 && <4.23,
        deepseq >=1.5 && <1.6,
        hashable >=1.4 && <1.6,
        primitive >=0.8 && <0.10,
        text >=2.0 && <2.2
    hs-source-dirs:   src
    default-language: Haskell2010

benchmark graft-bench
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Fixtures Residency
    hs-source-dirs:   bench
    build-depends:
        base >=4.19 && <4.23,
        deepseq >=1.5 && <1.6,
        graft,
        tasty-bench >=0.3.5 && <0.4,
        text >=2.0 && <2.2
    ghc-options:      -rtsopts -with-rtsopts=-T -fproc-alignment=64
    default-language: Haskell2010

test-suite graft-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    AstTests BuilderTests ChildEditTests LineIndexTests TestModel
    hs-source-dirs:   test
    build-depends:
        base >=4.19 && <4.23,
        graft,
        hashable >=1.4 && <1.6,
        QuickCheck >=2.14 && <2.19,
        text >=2.0 && <2.2
    default-language: Haskell2010

-- The README's worked example, built and run so that it tracks the API.
test-suite graft-example
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          ExactUpdate.hs
    hs-source-dirs:   examples
    build-depends:
        base >=4.19 && <4.23,
        graft,
        text >=2.0 && <2.2
    default-language: Haskell2010
